# Sarvam AI API Configuration
SARVAM_API_KEY=your_sarvam_api_key_here
# Set to 'true' during local testing to save credits (returns instant realistic plans)
# Set to 'false' during live pitch/demo to call live Sarvam LLM
SARVAM_MOCK=true

# FalkorDB Graph Database Configuration
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_GRAPH=ripple
